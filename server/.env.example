# CBT AI Question Lab — server keys
# Copy this file to server/.env and fill in your own values.
# Never commit real keys.

PORT=5050

# Recommended (needed for most models):
NVIDIA_ULTRA_KEY=
DEEPSEEK_KEY=
ZAI_KEY=

# Optional — embeddings / RAG:
NV_EMBEDDER_KEY=

# ==========================================
# NVIDIA FOUNDATION MODELS (Nemotron / Llama)
# ==========================================
NVIDIA_ULTRA_MODEL="nvidia/nemotron-3-ultra-550b-a55b"
NVIDIA_ULTRA_KEY=
NVIDIA_ULTRA_KEY_2=

NVIDIA_SUPER_120B_MODEL="nvidia/nemotron-3-super-120b-a12b"
NVIDIA_SUPER_120B_KEY=

NVIDIA_NEMOTRON_KEY=
NVIDIA_NANO_KEY=
NVIDIA_LLAMA_KEY=


# ==========================================
# DEEPSEEK MODELS
# ==========================================
DEEPSEEK_MODEL="deepseek-ai/deepseek-v4-pro"
DEEPSEEK_KEY=
DEEPSEEK_V4_PRO_KEY=

DEEPSEEK_V4_FLASH_MODEL="deepseek-ai/deepseek-v4-flash"
DEEPSEEK_V4_FLASH_KEY=


# ==========================================
# GPT OSS MODELS
# ==========================================
GPT_OSS_20B_MODEL="openai/gpt-oss-20b"
GPT_OSS_20B_KEY=

GPT_OSS_120B_MODEL="openai/gpt-oss-120b"
GPT_OSS_120B_KEY=


# ==========================================
# MICROSOFT / Z-AI / MISTRAL
# ==========================================
PHI4_MODEL="microsoft/phi-4-mini-instruct"
PHI4_KEY=

ZAI_MODEL="z-ai/glm-5.2"
ZAI_KEY=

MISTRAL_LARGE_KEY=
MISTRAL_NEMOTRON_KEY=


# ==========================================
# OTHER LLMS (Gemma, MiniMax, etc.)
# ==========================================
GEMMA4_KEY=
MINIMAX_KEY=
STEPFUN_KEY=
KIMI_KEY=
INKLING_KEY=
POOLSIDE_KEY=


# ==========================================
# AUDIO & SPEECH MODELS (TTS / ASR)
# ==========================================
# Whisper (Speech to Text)
NVIDIA_WHISPER_KEY=
NVIDIA_WHISPER_KEY_2=

# TTS (Text to Speech)
NVIDIA_TTS_KEY=
MAGPIE_TTS_KEY=


# ==========================================
# VISION & IMAGE MODELS
# ==========================================
DIFFUSIONGEMMA_KEY=
QWEN_IMAGE_KEY=
# Note: Stable Diffusion 3.5 reuses NVIDIA_ULTRA_KEY / NVIDIA_LLAMA_KEY


# ==========================================
# RAG, DOCUMENT & EMBEDDING MODELS
# ==========================================
NV_EMBEDDER_KEY=
NV_RETRIEVER_KEY=
NV_DOCUMENT_KEY=
NV_LAYOUT_KEY=

# Queue worker (Supabase)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
